# Planner — local Ollama by default (set PLANNER_BASE_URL to Cloud to switch back)
OLLAMA_PLANNER_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_PLANNER_API_KEY=ollama
OLLAMA_PLANNER_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_REASONING_EFFORT=none
OLLAMA_NUM_CTX=16384

# Optional Cloud fallback (used only when OLLAMA_PLANNER_BASE_URL is empty)
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1

# Embeddings — local Ollama
OLLAMA_EMBED_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_EMBED_API_KEY=ollama
OLLAMA_EMBED_MODEL=bge-m3:latest

# TUEV evaluation (official v2.0.1 eval split)
TUEV_DATA_DIR=D:\Datasets\TUH-EEG\TUEV\v2.0.1\edf\eval
TUEV_OUT_DIR=runs/tuev_agent_ollama
